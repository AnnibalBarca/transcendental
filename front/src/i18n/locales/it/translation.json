			"title": "Prendi il ladro di cavalli",
			"description": "Al posto della tua mossa: scambia uno dei tuoi cavalli con uno degli alfieri del tuo avversario."
		},
		"9": {
			"title": "Bestia da soma",
			"description": "Al posto della tua mossa: scambia uno dei tuoi cavalli con una delle torri del tuo avversario."
		},
		"10": {
			"title": "Bestificazione",
			"description": "Al posto della tua mossa: scambia uno dei tuoi alfieri con uno dei cavalli del tuo avversario."
		},
		"11": {
			"title": "Architetto eremita",
			"description": "Al posto della tua mossa: scambia uno dei tuoi alfieri con una delle torri avversarie."
		},
		"12": {
			"title": "Piromane",
			"description": "Al posto della tua mossa: scambia una delle tue torri con uno degli alfieri del tuo avversario."
		},
		"13": {
			"title": "Cannone",
			"description": "Al posto della tua mossa: scegli una delle tue torri; diventa un cannone. Cattura qualsiasi pezzo della sua colonna o traversa, ma non può più muoversi né dare scacco."
		},
		"14": {
			"title": "Cecchino",
			"description": "Al posto della tua mossa: scegli uno dei tuoi alfieri; diventa un cecchino. Per 3 turni, cattura senza spostarsi."
		},
		"15": {
			"title": "Pattumiera",
			"description": "Prima della tua mossa: metti due carte Scarto in cima al mazzo del tuo avversario; non hanno alcun effetto."
		},
		"16": {
			"title": "Respingere",
			"description": "Dopo la mossa del tuo avversario: se un tuo pezzo è appena stato catturato, annulla la sua mossa. In cambio, non potrai catturare nulla durante il tuo turno."
		},
		"17": {
			"title": "Campo di battaglia",
			"description": "Al posto della tua mossa: scegli un pezzo diverso dal re. Da ora in poi, finché non si muove o non viene distrutto, le caselle adiacenti formano un campo di battaglia. I pezzi esterni al campo di battaglia non possono attaccare quelli al suo interno."
		},
		"18": {
			"title": "Scarto",
			"description": "Carta senza effetto. Occupa soltanto un posto nella tua mano."
		},
		"19": {
			"title": "Annientamento",
			"description": "Al posto della tua mossa: rimuovi dalla partita un pedone a tua scelta."
		},
		"20": {
			"title": "Cavallo veterano",
			"description": "Dopo la tua mossa: scegli uno dei tuoi cavalli. Se non si muove in questo turno, diventerà cavallo veterano al prossimo. Oltre alla sua mossa abituale, ora raggiunge anche tutte le caselle adiacenti, come un re."
		},
		"21": {
			"title": "Torre veterana",
			"description": "Dopo la tua mossa: scegli una delle tue torri. Se non si muove in questo turno, diventerà torre veterana al prossimo. Oltre alla sua mossa abituale, ora raggiunge anche tutte le caselle adiacenti, come un re."
		},
		"22": {
			"title": "Alfiere veterano",
			"description": "Dopo la tua mossa: scegli uno dei tuoi alfieri. Se non si muove in questo turno, diventerà alfiere veterano al prossimo. Oltre alla sua mossa abituale, ora raggiunge anche tutte le caselle adiacenti, come un re."
		},
		"23": {
			"title": "Rana",
			"description": "Al posto della tua mossa: il tuo pedone salta oltre il pezzo che lo blocca, a patto che la casella d'arrivo sia libera."
		},
		"24": {
			"title": "Ruota della fortuna",
			"description": "Prima della tua mossa: scarta la tua mano e quella del tuo avversario, poi pesca 5 nuove carte dal mazzo."
		},
		"25": {
			"title": "Magnetismo",
			"description": "Dopo la tua mossa: finché il pezzo che hai appena mosso resta sulla sua casella, i pezzi vicini non possono più muoversi, se non per catturarlo. I re non vengono trattenuti."
		},
		"26": {
			"title": "Bastione",
			"description": "Dopo la tua mossa: il pezzo che hai appena mosso diventa un bastione. Finché resta sulla sua casella, verrà scambiato al posto del prossimo tuo pezzo che dovrebbe lasciare la scacchiera. Un re non può né proteggere né essere protetto."
		},
		"27": {
			"title": "Ninja",
			"description": "Prima della tua mossa: scegli uno dei tuoi pezzi. Fino all'inizio del tuo prossimo turno, gli altri pezzi possono attraversarlo come se la casella fosse vuota. Resta catturabile e può muoversi normalmente."
		},
		"28": {
			"title": "Traditore",
			"description": "Prima della tua mossa: puoi giocare i pedoni avversari e catturare pezzi avversari con essi, ma solo quando la loro mossa comporta una cattura."
		},
		"29": {
			"title": "Sfondamento",
			"description": "Al posto della tua mossa: scegli un pedone. Avanza da 1 a 3 caselle, a patto che il percorso sia libero. Non può essere catturato en passant."
		},
		"30": {
			"title": "Salvataggio insperato",
			"description": "Al posto della tua mossa: scegli una casella libera e non minacciata. Il tuo re viene teletrasportato lì."
		}
	},
	"legal": {
		"backHome": "Torna alla home",
		"privacy": {
			"title": "Informativa sulla privacy",
			"lastUpdated": "Ultimo aggiornamento: 19 agosto 2026",
			"sections": {
				"data": {
					"title": "Dati che raccogliamo",
					"body": "Indirizzo e-mail e nome utente al momento della registrazione. La password è memorizzata come hash, mai in chiaro. Se accedi tramite Google o 42, riceviamo il tuo indirizzo e-mail e il tuo identificativo pubblico."
				},
				"gameData": {
					"title": "Dati di gioco",
					"body": "Punteggio Elo, livello, esperienza, saldo di valuta virtuale, oggetti cosmetici posseduti, carte di gioco e avatar equipaggiato. Questi dati sono necessari al funzionamento del gioco."
				},
				"messages": {
					"title": "Messaggi",
					"body": "I messaggi inviati ai tuoi amici vengono conservati per permetterti di rileggere le tue conversazioni. Sono letti solo dai destinatari."
				},
				"retention": {
					"title": "Conservazione ed eliminazione",
					"body": "I tuoi dati vengono conservati finché il tuo account esiste. L'eliminazione del tuo account dalle impostazioni cancella definitivamente il tuo profilo, i tuoi messaggi e il tuo inventario."
				},
				"sharing": {
					"title": "Condivisione",
					"body": "Nessun dato viene venduto o trasmesso a terzi. Gli unici servizi esterni utilizzati sono Google e 42 per l'autenticazione, e Resend per l'invio delle e-mail di convalida."
				},
				"rights": {
					"title": "I tuoi diritti",
					"body": "Puoi consultare e modificare le tue informazioni dalle impostazioni, ed eliminare il tuo account in qualsiasi momento. L'eliminazione è definitiva e cancella i tuoi dati dal database."
				},
				"contact": {
					"title": "Contatto",
					"intro": "Per qualsiasi domanda relativa ai tuoi dati, scrivi al team del progetto.",
					"roles": {
						"leadBackend": "Lead Backend",
						"gameDesigner": "Game Designer",
						"cardArtist": "Card Artist",
						"frontendQA": "Frontend & QA",
						"devSecOps": "DevSecOps"
					},
					"outro": "Le regole d'uso del servizio sono riportate nei nostri"
				}
			}
		},
		"terms": {
			"title": "Termini di utilizzo",
			"lastUpdated": "Ultimo aggiornamento: 19 agosto 2026",
			"sections": {
				"purpose": {
					"title": "Oggetto del servizio",
					"body": "Questa piattaforma offre partite a scacchi online tra giocatori, con un sistema di carte che modifica lo svolgimento delle partite, una classifica Elo, una messaggistica tra amici e un negozio di oggetti cosmetici. È sviluppata nell'ambito del percorso formativo della scuola 42 e fornita a scopo didattico."
				},
				"account": {
					"title": "Account",
					"body": "Devi creare un account per giocare. Sei responsabile della riservatezza della tua password e delle azioni effettuate dal tuo account. Un account per persona: è vietata la creazione di account multipli per manipolare la classifica."
				},
				"conduct": {
					"title": "Norme di comportamento",
					"intro": "Sono vietati:",
					"items": [
						"Molestie, insulti e discorsi d'odio nella messaggistica o nei nomi utente.",
						"L'uso di un motore scacchistico o di qualsiasi software di assistenza durante una partita.",
						"L'abbandono volontario e ripetuto finalizzato a falsare la classifica di un altro giocatore.",
						"Qualsiasi tentativo di accesso non autorizzato ai server, ad account di terzi o all'API."
					]
				},
				"currency": {
					"title": "Valuta e oggetti virtuali",
					"body": "La valuta di gioco e gli oggetti cosmetici non hanno alcun valore monetario reale. Non possono essere scambiati al di fuori della piattaforma, né convertiti in denaro, né rimborsati. Restano legati al tuo account e scompaiono con esso."
				},
				"suspension": {
					"title": "Sospensione",
					"body": "Un account che non rispetta queste regole può essere sospeso o eliminato senza preavviso. Puoi eliminare il tuo account in qualsiasi momento dalle impostazioni: questa azione è definitiva."
				},
				"availability": {
					"title": "Disponibilità e garanzie",
					"body": "Il servizio è fornito «così com'è», senza garanzia di disponibilità né di assenza di errori. Trattandosi di un progetto studentesco, può essere interrotto, reimpostato o arrestato in qualsiasi momento, anche con perdita dei dati di gioco."
				},
				"privacy": {
					"title": "Dati personali",
					"body": "Il trattamento dei tuoi dati è descritto nella nostra"
				},
				"changes": {
					"title": "Evoluzione dei termini",
					"body": "Questi termini possono essere modificati. La data dell'ultimo aggiornamento è indicata in cima a questa pagina."
				}
			}
		}
	},
