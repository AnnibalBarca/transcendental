	"cards": {
		"0": {
			"title": "Dead zone",
			"description": "Before your move: one square becomes forbidden. Nobody may cross it or stop on it, except the knight, who may jump over it."
		},
		"1": {
			"title": "Time trial",
			"description": "After your move: during your opponent's next turn, their clock runs twice as fast."
		},
		"2": {
			"title": "Russian roulette",
			"description": "Instead of your move: a piece drawn at random on the board is removed from the game. Kings are spared."
		},
		"3": {
			"title": "Journey",
			"description": "Instead of your move: swap one of your rooks with one of your opponent's knights."
		},
		"4": {
			"title": "Fog",
			"description": "After your move: for 3 turns the board is hidden. You only see the squares your pieces can reach."
		},
		"5": {
			"title": "Mad knight",
			"description": "Instead of your move: swap one of your knights with one of your bishops."
		},
		"6": {
			"title": "Beast labour",
			"description": "Instead of your move: swap one of your knights with one of your rooks."
		},
		"7": {
			"title": "Raging mason",
			"description": "Instead of your move: swap one of your bishops with one of your rooks."
		},
		"8": {
			"title": "Catch the horse thief",
			"description": "Instead of your move: swap one of your knights with one of your opponent's bishops."
		},
		"9": {
			"title": "Beast of burden",
			"description": "Instead of your move: swap one of your knights with one of your opponent's rooks."
		},
		"10": {
			"title": "Beastification",
			"description": "Instead of your move: swap one of your bishops with one of your opponent's knights."
		},
		"11": {
			"title": "Hermit architect",
			"description": "Instead of your move: swap one of your bishops with one of the enemy rooks."
		},
		"12": {
			"title": "Arsonist",
			"description": "Instead of your move: swap one of your rooks with one of your opponent's bishops."
		},
		"13": {
			"title": "Cannon",
			"description": "Instead of your move: pick one of your rooks; it becomes a cannon. It captures any piece on its file or rank, but can no longer move or give check."
		},
		"14": {
			"title": "Sniper",
			"description": "Instead of your move: pick one of your bishops; it becomes a sniper. For 3 turns, it captures without moving."
		},
		"15": {
			"title": "Bin",
			"description": "Before your move: place two Junk cards on top of your opponent's deck; they have no effect."
		},
		"16": {
			"title": "Push back",
			"description": "After your opponent's move: if one of your pieces was just captured, cancel their move. In exchange, you cannot capture anything during your turn."
		},
		"17": {
			"title": "Battlefield",
			"description": "Instead of your move: pick a piece other than the king. From now on, until it moves or is destroyed, the squares next to it form a battlefield. Pieces outside a battlefield cannot attack pieces standing on one."
		},
		"18": {
			"title": "Junk",
			"description": "A card with no effect. It only takes up a slot in your hand."
		},
		"19": {
			"title": "Annihilation",
			"description": "Instead of your move: remove a foot soldier of your choice from the game."
		},
		"20": {
			"title": "Veteran knight",
			"description": "After your move: pick one of your knights. If it does not move this turn, it becomes a veteran knight next turn. On top of its usual move, it now also reaches every adjacent square, like a king."
		},
		"21": {
			"title": "Veteran rook",
			"description": "After your move: pick one of your rooks. If it does not move this turn, it becomes a veteran rook next turn. On top of its usual move, it now also reaches every adjacent square, like a king."
		},
		"22": {
			"title": "Veteran bishop",
			"description": "After your move: pick one of your bishops. If it does not move this turn, it becomes a veteran bishop next turn. On top of its usual move, it now also reaches every adjacent square, like a king."
		},
		"23": {
			"title": "Frog",
			"description": "Instead of your move: your foot soldier jumps over the piece blocking it, provided the landing square is free."
		},
		"24": {
			"title": "Wheel of fortune",
			"description": "Before your move: discard your hand and your opponent's, then draw 5 new cards from the deck."
		},
		"25": {
			"title": "Magnetism",
			"description": "After your move: while the piece you just moved stays on its square, the neighbouring pieces can no longer move, except to capture it. Kings are not held."
		},
		"26": {
			"title": "Bastion",
			"description": "After your move: the piece you just moved becomes a bastion. While it stays on its square, it is swapped in place of the next of your pieces that would leave the board. A king can neither protect nor be protected."
		},
		"27": {
			"title": "Ninja",
			"description": "Before your move: pick one of your pieces. Until the start of your next turn, other pieces may pass through it as if the square were empty. It remains capturable and can still move normally."
		},
		"28": {
			"title": "Traitor",
			"description": "Before your move: you may play the enemy foot soldiers and capture enemy pieces with them, but only when their move results in a capture."
		},
		"29": {
			"title": "Breakthrough",
			"description": "Instead of your move: pick a foot soldier. It advances 1 to 3 squares, provided the path is clear. It cannot be captured en passant."
		},
		"30": {
			"title": "Unlikely rescue",
			"description": "Instead of your move: pick a free square that is not under threat. Your king is teleported there."
		}
	},
	"legal": {
		"backHome": "Back to home",
		"privacy": {
			"title": "Privacy Policy",
			"lastUpdated": "Last updated: August 19, 2026",
			"sections": {
				"data": {
					"title": "Data we collect",
					"body": "Email address and username at sign-up. Password stored as a hash, never in plain text. If you sign in via Google or 42, we receive your email address and public identifier."
				},
				"gameData": {
					"title": "Game data",
					"body": "Elo rating, level, experience, virtual currency balance, owned cosmetic items, game cards and equipped avatar. This data is required for the game to function."
				},
				"messages": {
					"title": "Messages",
					"body": "Messages sent to your friends are kept so you can re-read your conversations. They are read only by their recipients."
				},
				"retention": {
					"title": "Retention and deletion",
					"body": "Your data is kept for as long as your account exists. Deleting your account from settings permanently erases your profile, messages and inventory."
				},
				"sharing": {
					"title": "Sharing",
					"body": "No data is sold or transferred to third parties. The only external services used are Google and 42 for authentication, and Resend for sending validation emails."
				},
				"rights": {
					"title": "Your rights",
					"body": "You can view and edit your information from settings, and delete your account at any time. Deletion is permanent and removes your data from the database."
				},
				"contact": {
					"title": "Contact",
					"intro": "For any question about your data, contact the project team.",
					"roles": {
						"leadBackend": "Lead Backend",
						"gameDesigner": "Game Designer",
						"cardArtist": "Card Artist",
						"frontendQA": "Frontend & QA",
						"devSecOps": "DevSecOps"
					},
					"outro": "The rules governing use of the service are set out in our"
				}
			}
		},
		"terms": {
			"title": "Terms of Service",
			"lastUpdated": "Last updated: August 19, 2026",
			"sections": {
				"purpose": {
					"title": "Purpose of the service",
					"body": "This platform offers online chess matches between players, with a card system that alters gameplay, an Elo ranking, a friends messaging system and a cosmetic items shop. It is developed as part of the 42 school curriculum and provided for educational purposes."
				},
				"account": {
					"title": "Account",
					"body": "You must create an account to play. You are responsible for keeping your password confidential and for actions taken from your account. One account per person: creating multiple accounts to manipulate the ranking is prohibited."
				},
				"conduct": {
					"title": "Rules of conduct",
					"intro": "The following are prohibited:",
					"items": [
						"Harassment, insults and hateful language in messages or usernames.",
						"Using a chess engine or any assistance software during a match.",
						"Deliberate, repeated abandonment intended to distort another player's ranking.",
						"Any attempt to gain unauthorized access to servers, third-party accounts or the API."
					]
				},
				"currency": {
					"title": "Virtual currency and items",
					"body": "In-game currency and cosmetic items have no real monetary value. They cannot be traded outside the platform, converted to money, or refunded. They remain tied to your account and disappear with it."
				},
				"suspension": {
					"title": "Suspension",
					"body": "An account that violates these rules may be suspended or deleted without notice. You may delete your account at any time from settings: this action is permanent."
				},
				"availability": {
					"title": "Availability and warranties",
					"body": "The service is provided \"as is\", with no guarantee of availability or error-free operation. As a student project, it may be interrupted, reset or shut down at any time, including with loss of game data."
				},
				"privacy": {
					"title": "Personal data",
					"body": "The processing of your data is described in our"
				},
				"changes": {
					"title": "Changes to these terms",
					"body": "These terms may be changed. The last-updated date appears at the top of this page."
				}
			}
		}
	},
