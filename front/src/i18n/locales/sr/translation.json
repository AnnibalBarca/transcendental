		"25": {
			"title": "Magnetizam",
			"description": "Posle tvog poteza: dok figura koju si upravo pomerio ostaje na svom polju, susedne figure više ne mogu da se pomeraju, osim da je uzmu. Kraljevi nisu zadržani."
		},
		"26": {
			"title": "Bastion",
			"description": "Posle tvog poteza: figura koju si upravo pomerio postaje bastion. Dok ostaje na svom polju, biva zamenjena umesto sledeće tvoje figure koja bi trebalo da napusti tablu. Kralj ne može ni da štiti ni da bude zaštićen."
		},
		"27": {
			"title": "Nindža",
			"description": "Pre tvog poteza: izaberi jednu svoju figuru. Do početka tvog sledećeg poteza, druge figure mogu da prolaze kroz nju kao da je polje prazno. Ostaje podložna uzimanju i može normalno da se pomera."
		},
		"28": {
			"title": "Izdajnik",
			"description": "Pre tvog poteza: možeš da igraš protivničke pešake i njima uzimaš protivničke figure, ali samo kada njihov potez rezultira uzimanjem."
		},
		"29": {
			"title": "Proboj",
			"description": "Umesto tvog poteza: izaberi pešaka. Napreduje 1 do 3 polja, pod uslovom da je put slobodan. Ne može biti uzet en passant."
		},
		"30": {
			"title": "Neočekivano spasenje",
			"description": "Umesto tvog poteza: izaberi slobodno polje koje nije ugroženo. Tvoj kralj se teleportuje tamo."
		}
