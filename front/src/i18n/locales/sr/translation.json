	"legal": {
		"backHome": "Nazad na početnu",
		"privacy": {
			"title": "Politika privatnosti",
			"lastUpdated": "Poslednje ažuriranje: 19. avgust 2026.",
			"sections": {
				"data": {
					"title": "Podaci koje prikupljamo",
					"body": "Adresa e-pošte i korisničko ime prilikom registracije. Lozinka se čuva kao heš, nikada u čistom tekstu. Ako se prijavite putem Google-a ili 42, dobijamo vašu adresu e-pošte i javni identifikator."
				},
				"gameData": {
					"title": "Podaci o igri",
					"body": "Elo rejting, nivo, iskustvo, stanje virtuelne valute, posedovani kozmetički predmeti, karte za igru i opremljeni avatar. Ovi podaci su neophodni za funkcionisanje igre."
				},
				"messages": {
					"title": "Poruke",
					"body": "Poruke poslate vašim prijateljima se čuvaju kako biste mogli ponovo da pročitate svoje razgovore. Čitaju ih samo primaoci."
				},
				"retention": {
					"title": "Čuvanje i brisanje",
					"body": "Vaši podaci se čuvaju sve dok vaš nalog postoji. Brisanje vašeg naloga iz podešavanja trajno briše vaš profil, poruke i inventar."
				},
				"sharing": {
					"title": "Deljenje",
					"body": "Nijedan podatak se ne prodaje niti prenosi trećim licima. Jedine spoljne usluge koje se koriste su Google i 42 za autentifikaciju, i Resend za slanje e-poruka za potvrdu."
				},
				"rights": {
					"title": "Vaša prava",
					"body": "Možete pregledati i menjati svoje podatke iz podešavanja, i obrisati svoj nalog u bilo kom trenutku. Brisanje je trajno i uklanja vaše podatke iz baze."
				},
				"contact": {
					"title": "Kontakt",
					"intro": "Za sva pitanja u vezi sa vašim podacima, obratite se timu projekta.",
					"roles": {
						"leadBackend": "Lead Backend",
						"gameDesigner": "Game Designer",
						"cardArtist": "Card Artist",
						"frontendQA": "Frontend & QA",
						"devSecOps": "DevSecOps"
					},
					"outro": "Pravila korišćenja usluge navedena su u našim"
				}
			}
		},
		"terms": {
			"title": "Uslovi korišćenja",
			"lastUpdated": "Poslednje ažuriranje: 19. avgust 2026.",
			"sections": {
				"purpose": {
					"title": "Predmet usluge",
					"body": "Ova platforma nudi online šahovske partije između igrača, sa sistemom karata koje menjaju tok partija, Elo rangiranjem, porukama između prijatelja i prodavnicom kozmetičkih predmeta. Razvijena je u okviru nastavnog plana škole 42 i pruža se u obrazovne svrhe."
				},
				"account": {
					"title": "Nalog",
					"body": "Morate kreirati nalog da biste igrali. Odgovorni ste za poverljivost svoje lozinke i za radnje izvršene sa vašeg naloga. Jedan nalog po osobi: kreiranje više naloga radi manipulacije rangiranjem je zabranjeno."
				},
				"conduct": {
					"title": "Pravila ponašanja",
					"intro": "Zabranjeno je:",
					"items": [
						"Uznemiravanje, uvrede i govor mržnje u porukama ili korisničkim imenima.",
						"Korišćenje šahovskog motora ili bilo kog softvera za pomoć tokom partije.",
						"Namerno, ponovljeno odustajanje sa ciljem narušavanja rangiranja drugog igrača.",
						"Svaki pokušaj neovlašćenog pristupa serverima, nalozima trećih lica ili API-ju."
					]
				},
				"currency": {
					"title": "Virtuelna valuta i predmeti",
					"body": "Igrana valuta i kozmetički predmeti nemaju nikakvu stvarnu novčanu vrednost. Ne mogu se razmenjivati van platforme, niti pretvarati u novac, niti refundirati. Ostaju vezani za vaš nalog i nestaju sa njim."
				},
				"suspension": {
					"title": "Suspenzija",
					"body": "Nalog koji ne poštuje ova pravila može biti suspendovan ili obrisan bez prethodnog obaveštenja. Svoj nalog možete obrisati u bilo kom trenutku iz podešavanja: ova radnja je trajna."
				},
				"availability": {
					"title": "Dostupnost i garancije",
					"body": "Usluga se pruža „takva kakva jeste\", bez garancije dostupnosti ili odsustva grešaka. Kao studentski projekat, može biti prekinuta, resetovana ili obustavljena u bilo kom trenutku, uključujući gubitak podataka o igri."
				},
				"privacy": {
					"title": "Lični podaci",
					"body": "Obrada vaših podataka opisana je u našoj"
				},
				"changes": {
					"title": "Izmene uslova",
					"body": "Ovi uslovi mogu biti izmenjeni. Datum poslednjeg ažuriranja naveden je na vrhu ove stranice."
				}
			}
		}
	},
