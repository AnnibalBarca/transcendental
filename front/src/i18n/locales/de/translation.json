		"5": {
			"title": "Verrückter Springer",
			"description": "Statt deines Zuges: tausche einen deiner Springer mit einem deiner Läufer."
		},
		"6": {
			"title": "Tierische Arbeit",
			"description": "Statt deines Zuges: tausche einen deiner Springer mit einem deiner Türme."
		},
		"7": {
			"title": "Wütender Maurer",
			"description": "Statt deines Zuges: tausche einen deiner Läufer mit einem deiner Türme."
		},
		"8": {
			"title": "Fang den Pferdedieb",
			"description": "Statt deines Zuges: tausche einen deiner Springer mit einem gegnerischen Läufer."
		},
		"9": {
			"title": "Lasttier",
			"description": "Statt deines Zuges: tausche einen deiner Springer mit einem gegnerischen Turm."
		},
		"10": {
			"title": "Vertierung",
			"description": "Statt deines Zuges: tausche einen deiner Läufer mit einem gegnerischen Springer."
		},
		"11": {
			"title": "Einsiedler-Architekt",
			"description": "Statt deines Zuges: tausche einen deiner Läufer mit einem gegnerischen Turm."
		},
		"12": {
			"title": "Brandstifter",
			"description": "Statt deines Zuges: tausche einen deiner Türme mit einem gegnerischen Läufer."
		},
		"13": {
			"title": "Kanone",
			"description": "Statt deines Zuges: wähle einen deiner Türme; er wird zur Kanone. Er schlägt jede Figur auf seiner Linie oder Reihe, kann aber nicht mehr ziehen oder Schach geben."
		},
		"14": {
			"title": "Scharfschütze",
			"description": "Statt deines Zuges: wähle einen deiner Läufer; er wird zum Scharfschützen. Für 3 Züge schlägt er, ohne sich zu bewegen."
		},
		"15": {
			"title": "Mülltonne",
			"description": "Vor deinem Zug: lege zwei Schrottkarten oben auf den Nachziehstapel deines Gegners; sie bewirken nichts."
		},
		"16": {
			"title": "Zurückdrängen",
			"description": "Nach dem Zug deines Gegners: wurde gerade eine deiner Figuren geschlagen, mache seinen Zug rückgängig. Im Gegenzug darfst du in deinem Zug nichts schlagen."
		},
		"17": {
			"title": "Schlachtfeld",
			"description": "Statt deines Zuges: wähle eine Figur außer dem König. Von nun an, bis sie zieht oder zerstört wird, bilden die Nachbarfelder ein Schlachtfeld. Figuren außerhalb eines Schlachtfelds können Figuren darauf nicht angreifen."
		},
		"18": {
			"title": "Schrott",
			"description": "Karte ohne Wirkung. Sie belegt nur einen Platz auf deiner Hand."
		},
		"19": {
			"title": "Vernichtung",
			"description": "Statt deines Zuges: entferne einen Bauern deiner Wahl aus der Partie."
		},
		"20": {
			"title": "Veteranenspringer",
			"description": "Nach deinem Zug: wähle einen deiner Springer. Zieht er in diesem Zug nicht, wird er im nächsten zum Veteranenspringer. Zusätzlich zu seinem üblichen Zug erreicht er nun auch jedes Nachbarfeld, wie ein König."
		},
		"21": {
			"title": "Veteranenturm",
			"description": "Nach deinem Zug: wähle einen deiner Türme. Zieht er in diesem Zug nicht, wird er im nächsten zum Veteranenturm. Zusätzlich zu seinem üblichen Zug erreicht er nun auch jedes Nachbarfeld, wie ein König."
		},
		"22": {
			"title": "Veteranenläufer",
			"description": "Nach deinem Zug: wähle einen deiner Läufer. Zieht er in diesem Zug nicht, wird er im nächsten zum Veteranenläufer. Zusätzlich zu seinem üblichen Zug erreicht er nun auch jedes Nachbarfeld, wie ein König."
		},
		"23": {
			"title": "Frosch",
			"description": "Statt deines Zuges: dein Bauer springt über die Figur, die ihn blockiert, sofern das Zielfeld frei ist."
		},
		"24": {
			"title": "Glücksrad",
			"description": "Vor deinem Zug: wirf deine Hand und die deines Gegners ab und ziehe 5 neue Karten vom Stapel."
		},
		"25": {
			"title": "Magnetismus",
			"description": "Nach deinem Zug: solange die eben gezogene Figur auf ihrem Feld bleibt, können die benachbarten Figuren nicht mehr ziehen, außer um sie zu schlagen. Könige werden nicht festgehalten."
		},
		"26": {
			"title": "Bastion",
			"description": "Nach deinem Zug: die eben gezogene Figur wird zur Bastion. Solange sie auf ihrem Feld bleibt, wird sie anstelle der nächsten deiner Figuren getauscht, die das Brett verlassen würde. Ein König kann weder schützen noch geschützt werden."
		},
		"27": {
			"title": "Ninja",
			"description": "Vor deinem Zug: wähle eine deiner Figuren. Bis zum Beginn deines nächsten Zuges dürfen andere Figuren durch sie hindurchziehen, als wäre das Feld leer. Sie bleibt schlagbar und darf weiterhin normal ziehen."
		},
		"28": {
			"title": "Verräter",
			"description": "Vor deinem Zug: du darfst die gegnerischen Bauern ziehen und damit gegnerische Figuren schlagen, aber nur wenn ihr Zug zu einem Schlagen führt."
		},
		"29": {
			"title": "Durchbruch",
			"description": "Statt deines Zuges: wähle einen Bauern. Er rückt 1 bis 3 Felder vor, sofern der Weg frei ist. Er kann nicht en passant geschlagen werden."
		},
		"30": {
			"title": "Unverhoffte Rettung",
			"description": "Statt deines Zuges: wähle ein freies, nicht bedrohtes Feld. Dein König wird dorthin teleportiert."
		}
	},
	"legal": {
		"backHome": "Zurück zur Startseite",
		"privacy": {
			"title": "Datenschutzerklärung",
			"lastUpdated": "Zuletzt aktualisiert: 19. August 2026",
			"sections": {
				"data": {
					"title": "Daten, die wir erheben",
					"body": "E-Mail-Adresse und Benutzername bei der Registrierung. Das Passwort wird als Hash gespeichert, niemals im Klartext. Wenn Sie sich über Google oder 42 anmelden, erhalten wir Ihre E-Mail-Adresse und Ihre öffentliche Kennung."
				},
				"gameData": {
					"title": "Spieldaten",
					"body": "Elo-Wertung, Level, Erfahrung, Guthaben der virtuellen Währung, besessene kosmetische Gegenstände, Spielkarten und ausgerüsteter Avatar. Diese Daten sind für die Funktion des Spiels erforderlich."
				},
				"messages": {
					"title": "Nachrichten",
					"body": "Nachrichten, die Sie an Ihre Freunde senden, werden gespeichert, damit Sie Ihre Unterhaltungen erneut lesen können. Sie werden nur von den Empfängern gelesen."
				},
				"retention": {
					"title": "Aufbewahrung und Löschung",
					"body": "Ihre Daten werden aufbewahrt, solange Ihr Konto besteht. Das Löschen Ihres Kontos in den Einstellungen entfernt endgültig Ihr Profil, Ihre Nachrichten und Ihr Inventar."
				},
				"sharing": {
					"title": "Weitergabe",
					"body": "Es werden keine Daten verkauft oder an Dritte weitergegeben. Die einzigen genutzten externen Dienste sind Google und 42 zur Authentifizierung sowie Resend zum Versand der Bestätigungs-E-Mails."
				},
				"rights": {
					"title": "Ihre Rechte",
					"body": "Sie können Ihre Informationen in den Einstellungen einsehen und ändern sowie Ihr Konto jederzeit löschen. Die Löschung ist endgültig und entfernt Ihre Daten aus der Datenbank."
				},
				"contact": {
					"title": "Kontakt",
					"intro": "Bei Fragen zu Ihren Daten wenden Sie sich bitte an das Projektteam.",
					"roles": {
						"leadBackend": "Lead Backend",
						"gameDesigner": "Game Designer",
						"cardArtist": "Card Artist",
						"frontendQA": "Frontend & QA",
						"devSecOps": "DevSecOps"
					},
					"outro": "Die Nutzungsregeln des Dienstes finden Sie in unseren"
				}
			}
		},
		"terms": {
			"title": "Nutzungsbedingungen",
			"lastUpdated": "Zuletzt aktualisiert: 19. August 2026",
			"sections": {
				"purpose": {
					"title": "Zweck des Dienstes",
					"body": "Diese Plattform bietet Online-Schachpartien zwischen Spielern mit einem Kartensystem, das den Spielverlauf verändert, einer Elo-Rangliste, einem Freunde-Chat und einem Shop für kosmetische Gegenstände. Sie wird im Rahmen des Lehrplans der Schule 42 entwickelt und zu Bildungszwecken bereitgestellt."
				},
				"account": {
					"title": "Konto",
					"body": "Um zu spielen, müssen Sie ein Konto erstellen. Sie sind für die Vertraulichkeit Ihres Passworts und für Handlungen von Ihrem Konto aus verantwortlich. Ein Konto pro Person: Das Erstellen mehrerer Konten zur Manipulation der Rangliste ist untersagt."
				},
				"conduct": {
					"title": "Verhaltensregeln",
					"intro": "Untersagt sind:",
					"items": [
						"Belästigung, Beleidigungen und Hassrede im Chat oder in Benutzernamen.",
						"Die Nutzung einer Schach-Engine oder anderer Hilfssoftware während einer Partie.",
						"Absichtliches, wiederholtes Aufgeben mit dem Ziel, die Rangliste eines anderen Spielers zu verfälschen.",
						"Jeder Versuch eines unbefugten Zugriffs auf Server, fremde Konten oder die API."
					]
				},
				"currency": {
					"title": "Virtuelle Währung und Gegenstände",
					"body": "Die Spielwährung und kosmetische Gegenstände haben keinen realen Geldwert. Sie können weder außerhalb der Plattform getauscht, noch in Geld umgewandelt oder erstattet werden. Sie bleiben an Ihr Konto gebunden und verschwinden mit diesem."
				},
				"suspension": {
					"title": "Sperrung",
					"body": "Ein Konto, das gegen diese Regeln verstößt, kann ohne Vorankündigung gesperrt oder gelöscht werden. Sie können Ihr Konto jederzeit in den Einstellungen löschen: Diese Aktion ist endgültig."
				},
				"availability": {
					"title": "Verfügbarkeit und Gewährleistung",
					"body": "Der Dienst wird „wie besehen“ bereitgestellt, ohne Garantie auf Verfügbarkeit oder Fehlerfreiheit. Als Studierendenprojekt kann er jederzeit unterbrochen, zurückgesetzt oder eingestellt werden, auch mit Verlust von Spieldaten."
				},
				"privacy": {
					"title": "Personenbezogene Daten",
					"body": "Die Verarbeitung Ihrer Daten wird in unserer"
				},
				"changes": {
					"title": "Änderungen dieser Bedingungen",
					"body": "Diese Bedingungen können geändert werden. Das Datum der letzten Aktualisierung finden Sie oben auf dieser Seite."
				}
			}
		}
	},
